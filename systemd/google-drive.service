[Unit]
Description=Google Drive for Desktop (VFS Streaming Mount)
Documentation=https://github.com/google-drive-linux
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/google-drive-agent mount-foreground
ExecStop=%h/.local/bin/google-drive-agent unmount
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
